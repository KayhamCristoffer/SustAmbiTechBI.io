{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ============================================================
  // SustAmbiTech Eletropostos — Configuração Cloudflare Pages
  // ============================================================
  // PLANO GRATUITO (Free):
  //   - Pages: hospedagem ilimitada, 500 deploys/mês, CDN global
  //   - D1: 5 GB storage, 5M leituras/dia, 100K escritas/dia
  //   - Workers: 100k req/dia, 10ms CPU por request
  //
  // PLANO PAGO (Workers Paid - US$5/mês):
  //   - Workers: 10M req/mês inclusos + US$0.30/1M extras
  //   - D1: 25 GB storage, 25M leituras/dia, 500K escritas/dia
  //   - CPU time: 30ms por request (vs 10ms no free)
  //   - Habilita: Workers Analytics Engine, Durable Objects, etc.
  //
  // PARA ATIVAR PLANO PAGO: adicione `"usage_model": "bundled"` abaixo
  // ============================================================

  "name": "sustambitech-bi",
  "compatibility_date": "2024-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",

  // D1 Database — Banco de dados SQLite serverless gratuito
  // SETUP INICIAL (execute UMA vez no terminal):
  //
  //   PASSO 1 — Criar o banco de produção:
  //     npx wrangler d1 create sustambitech-production
  //     → Copie o "database_id" gerado e cole no campo abaixo
  //
  //   PASSO 2 — Aplicar schema e seed em PRODUÇÃO:
  //     npx wrangler d1 execute sustambitech-production --file=./migrations/0001_initial_schema.sql
  //     npx wrangler d1 execute sustambitech-production --file=./seed.sql
  //
  //   PASSO 3 — Vincular no Pages Dashboard:
  //     Pages → Settings → Functions → D1 bindings
  //     Variable name: DB | Database: sustambitech-production
  //
  // DESENVOLVIMENTO LOCAL (sem conta Cloudflare necessária):
  //   npx wrangler d1 execute sustambitech-production --local --file=./migrations/0001_initial_schema.sql
  //   npx wrangler d1 execute sustambitech-production --local --file=./seed.sql
  //   npx wrangler pages dev dist --d1=sustambitech-production --local --port 3000
  //
  // CONSULTAS LOCAIS:
  //   npx wrangler d1 execute sustambitech-production --local --command="SELECT COUNT(*) FROM postos_recarga"
  //
  // CONSULTAS EM PRODUÇÃO:
  //   npx wrangler d1 execute sustambitech-production --command="SELECT COUNT(*) FROM postos_recarga"
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sustambitech-production",
      // SUBSTITUA pelo database_id gerado pelo comando `wrangler d1 create`
      // Formato: "xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
      "database_id": "local-sustambitech-db"
    }
  ]

  // ============================================================
  // SERVIÇOS ADICIONAIS (descomente quando necessário)
  // ============================================================

  // KV Storage — Armazenamento chave-valor (somente BYOK/conta própria)
  // NOTA: KV NÃO é suportado no hosted deploy do Genspark
  // Use tabela D1 como alternativa: CREATE TABLE kv (key TEXT PRIMARY KEY, value TEXT)
  // Para ativar com conta própria:
  //   npx wrangler kv:namespace create sustambitech_KV
  //   npx wrangler kv:namespace create sustambitech_KV --preview
  // "kv_namespaces": [
  //   {
  //     "binding": "KV",
  //     "id": "seu-kv-id",
  //     "preview_id": "seu-kv-preview-id"
  //   }
  // ],

  // R2 Storage — Object storage (fotos dos postos, documentos)
  //   npx wrangler r2 bucket create sustambitech-bucket
  // "r2_buckets": [
  //   {
  //     "binding": "R2",
  //     "bucket_name": "sustambitech-bucket"
  //   }
  // ]
}
